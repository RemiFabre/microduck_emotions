+            let back = 1.0 - ramp(t - CQ_BACK, CQ_BACK_LEN);
+            let forward = ramp(t, CQ_FORWARD_LEN);
+            let roll = if t < CQ_TILT2 {
+                CQ_TILT_RIGHT * ramp(t - CQ_TILT1, CQ_TILT_LEN)
+            } else {
