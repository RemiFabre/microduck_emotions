+const CQ_BACK: f64 = 2.1;
+const CQ_BACK_LEN: f64 = 0.5;
+/// The beak, 0..1 every 0.1 s: a snap open on each chirp, shut otherwise.
+const CQ_MOUTH: [f64; 17] = [
