+    # ── Task rewards (all bounded per step, window-gated; see the spec's table) ─
+    cfg.rewards["stomp_foot_lift"] = RewardTermCfg(
+        func=microduck_mdp.stomp_foot_lift, weight=3.0,
+        params={"asset_cfg": stomp_site, "windows": LIFT_WINDOWS,
+                "target": FOOT_LIFT_TARGET, "dead_zone": FOOT_LIFT_DEADZONE,
+                "gate_sensor_name": feet_ground_cfg.name, "gate_slot": support_slot},
+    )
+    cfg.rewards["stomp_foot_impact"] = RewardTermCfg(
+        func=microduck_mdp.stomp_foot_impact, weight=3.0,
+        params={"asset_cfg": stomp_site, "windows": IMPACT_WINDOWS, "v_cap": STOMP_V_CAP,
+                "gate_sensor_name": feet_ground_cfg.name, "gate_slot": support_slot},
+    )
+    cfg.rewards["stomp_foot_planted"] = RewardTermCfg(
+        func=microduck_mdp.foot_contact_outside_windows, weight=1.0,
+        params={"sensor_name": feet_ground_cfg.name, "slot": stomp_slot,
+                "windows": STOMP_WINDOWS},
+    )
+    cfg.rewards["support_foot_grounded"] = RewardTermCfg(
+        func=microduck_mdp.foot_contact_reward, weight=2.0,
+        params={"sensor_name": feet_ground_cfg.name, "slot": support_slot},
+    )
+    cfg.rewards["head_yaw_track"] = RewardTermCfg(
+        func=microduck_mdp.head_yaw_schedule_track, weight=3.0,
+        params={"keyframes": HEAD_YAW_KEYFRAMES, "std": 0.25, "joint_index": HEAD_YAW_IDX},
+    )
+    # Stand cleanly around the stomps: loose legs (the stomp is a transient), level head.
+    cfg.rewards["pose_stand_legs"] = RewardTermCfg(
+        func=microduck_mdp.pose_target_match, weight=1.5,
+        params={"std": 0.5, "joint_indices": _LEG_JOINTS, "target_overrides": None},
+    )
+    cfg.rewards["pose_head_level"] = RewardTermCfg(
+        func=microduck_mdp.pose_target_match, weight=1.0,
+        params={"std": 0.3, "joint_indices": _HEAD_LEVEL, "target_overrides": None},
+    )
+    cfg.rewards["end_stand"] = RewardTermCfg(
+        func=microduck_mdp.pose_match_in_windows, weight=2.0,
+        params={"windows": [END_STAND], "std": 0.25, "joint_indices": _ALL_JOINTS},
+    )
+    cfg.rewards["upright"].params["asset_cfg"].body_names = ("trunk_base",)
+    cfg.rewards["upright"].weight = 2.0
+    cfg.rewards["upright"].params["std"] = math.sqrt(0.05)
+    cfg.rewards["height_stand"] = RewardTermCfg(
+        func=microduck_mdp.height_target_gaussian, weight=1.0,
+        params={"std": 0.04, "target_height": STAND_Z,
+                "asset_cfg": SceneEntityCfg("robot", body_names=("trunk_base",))},
+    )
+    # ── Anti-violence (self-negating <= 0 functions -> POSITIVE weights) ─────────
+    cfg.rewards["trunk_az"] = RewardTermCfg(
+        func=microduck_mdp.trunk_vertical_accel_penalty, weight=0.005,
+        params={"asset_cfg": SceneEntityCfg("robot", body_names=("trunk_base",))},
+    )
+    cfg.rewards["foot_overspeed"] = RewardTermCfg(
+        func=microduck_mdp.foot_overspeed_penalty, weight=1.0,
+        params={"asset_cfg": stomp_site, "limit": FOOT_OVERSPEED},
+    )
+    # ── Costs (>= 0 functions -> NEGATIVE weights; kick-env values) ───────────
+    # dof_pos_limits (-1.0) is inherited from the base, as in the kick env.
+    cfg.rewards["action_rate_l2"].weight = -0.1      # stage 0; curriculum ramps to -0.6
+    cfg.rewards["body_ang_vel"].params["asset_cfg"].body_names = ("trunk_base",)
+    cfg.rewards["body_ang_vel"].weight = -0.05
+    cfg.rewards["angular_momentum"].weight = -0.02
+    cfg.rewards["self_collisions"] = RewardTermCfg(
+        func=mdp.self_collision_cost, weight=-1.0,
+        params={"sensor_name": self_collision_cfg.name},
+    )
+    # ── Diagnostic: success rate (weight 1e-3 so mjlab logs it) ──────────────
+    cfg.rewards["stomp_success"] = RewardTermCfg(
+        func=microduck_mdp.stomp_success, weight=1e-3,
+        params={"foot_cfg": stomp_site, "stomp_windows": STOMP_WINDOWS,
+                "yaw_windows": [YAW_LEFT_WINDOW, YAW_RIGHT_WINDOW],
+                "min_clearance": SUCCESS_CLEARANCE, "min_yaw": SUCCESS_YAW,
+                "joint_index": HEAD_YAW_IDX},
