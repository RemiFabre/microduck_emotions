diff --git a/src/mjlab_microduck/tasks/mdp.py b/src/mjlab_microduck/tasks/mdp.py
index 9c7efb7..950a6c2 100644
--- a/src/mjlab_microduck/tasks/mdp.py
+++ b/src/mjlab_microduck/tasks/mdp.py
@@ -8144,3 +8144,187 @@ def flb_swing_foot_clear(
     reward = torch.exp(-((z - target) / std) ** 2)
     stance_found, _ = _fl_feet_found(env, sensor_name, side)
     return reward * stance_found * _smoothstep(alpha, lo, hi)
+
+
+# --- stomp -------------------------------------------------------------------
+# Angry double stomp (docs/superpowers/specs/2026-09-04-angry-stomp-design.md):
+# one fixed foot lifts and bangs down twice, head yaw left on the first stomp and
+# right on the second, ends standing. The ENV knows the elapsed episode time
+# (episode_length_buf * step_dt) and gates the rewards on fixed time windows; the
+# POLICY does not see any clock (61-D obs, happy-hop contract) and must keep time
+# in its own body state (head yaw = its memory register).
+
+
+def _episode_time_s(env: ManagerBasedRlEnv) -> torch.Tensor:
+    """Seconds since the episode start, shape (num_envs,)."""
+    return env.episode_length_buf.float() * float(env.step_dt)
+
+
+def _in_windows(env: ManagerBasedRlEnv, windows) -> torch.Tensor:
+    """1.0 where the episode time is inside any half-open window [lo, hi), else 0."""
+    # eps (1/10 of a control step) makes the boundaries exact in float32: a step at
+    # exactly ``lo`` counts in, a step at exactly ``hi`` counts out.
+    t = _episode_time_s(env)
+    eps = 0.1 * float(env.step_dt)
+    mask = torch.zeros_like(t)
+    for lo, hi in windows:
+        mask = torch.maximum(mask, ((t >= float(lo) - eps) & (t < float(hi) - eps)).float())
+    return mask
+
+
+def _foot_site_z(env: ManagerBasedRlEnv, asset_cfg: SceneEntityCfg) -> torch.Tensor:
+    asset: Entity = env.scene[asset_cfg.name]
+    z = asset.data.site_pos_w[:, asset_cfg.site_ids[0], 2] - env.scene.terrain.env_origins[:, 2]
+    return torch.nan_to_num(z, nan=0.0)
+
+
+def _foot_site_vel(env: ManagerBasedRlEnv, asset_cfg: SceneEntityCfg) -> torch.Tensor:
+    asset: Entity = env.scene[asset_cfg.name]
+    v = asset.data.site_lin_vel_w[:, asset_cfg.site_ids[0], :]
+    return torch.nan_to_num(v, nan=0.0)
+
+
+def stomp_foot_lift(
+    env: ManagerBasedRlEnv,
+    asset_cfg: SceneEntityCfg,
+    windows,
+    target: float = 0.04,
+    dead_zone: float = 0.005,
+    gate_sensor_name: str | None = None,
+    gate_slot: int = 0,
+) -> torch.Tensor:
+    """Dense foot-height ramp clamp((z - dead_zone)/(target - dead_zone), 0, 1) for the
+    stomping foot, paid only inside the LIFT windows and only while the support foot
+    (``gate_slot``) is in contact (a hop pays nothing). Saturates at ``target``: no bonus
+    for kicking higher. Bounded per step -> no jackpot."""
+    z = _foot_site_z(env, asset_cfg)
+    reward = torch.clamp((z - dead_zone) / max(target - dead_zone, 1e-6), 0.0, 1.0)
+    reward = reward * _in_windows(env, windows)
+    if gate_sensor_name is not None:
+        reward = reward * _foot_found(env, gate_sensor_name, gate_slot)
+    return reward
+
+
+def stomp_foot_impact(
+    env: ManagerBasedRlEnv,
+    asset_cfg: SceneEntityCfg,
+    windows,
+    v_cap: float = 0.4,
+    gate_sensor_name: str | None = None,
+    gate_slot: int = 0,
+) -> torch.Tensor:
+    """The stomp itself: DOWNWARD velocity of the stomping-foot site, clamp(-v_z / v_cap, 0, 1),
+    paid only inside the IMPACT windows and only while the support foot is in contact.
+    CAPPED at ``v_cap`` (0.4 m/s = a 4 cm drop in 0.1 s) so a faster slam earns nothing more:
+    a stomp, not a slam. Once the foot is on the floor v_z = 0 and the term pays nothing."""
+    vz = _foot_site_vel(env, asset_cfg)[:, 2]
+    reward = torch.clamp(-vz / max(v_cap, 1e-6), 0.0, 1.0)
+    reward = reward * _in_windows(env, windows)
+    if gate_sensor_name is not None:
+        reward = reward * _foot_found(env, gate_sensor_name, gate_slot)
+    return reward
+
+
+def foot_contact_outside_windows(
+    env: ManagerBasedRlEnv,
+    sensor_name: str,
+    slot: int,
+    windows,
+) -> torch.Tensor:
+    """+1 while the given foot touches the ground at every time NOT inside ``windows``
+    (the stomping foot is down between the stomps and at the end; no third stomp)."""
+    return _foot_found(env, sensor_name, slot) * (1.0 - _in_windows(env, windows))
+
+
+def foot_overspeed_penalty(
+    env: ManagerBasedRlEnv,
+    asset_cfg: SceneEntityCfg,
+    limit: float = 0.8,
+) -> torch.Tensor:
+    """<= 0 (self-negating -> POSITIVE weight): -max(0, |v_foot| - limit)^2, always on.
+    The 'no thrashing' guard on the moving foot; ``limit`` is twice the rewarded impact speed."""
+    speed = torch.linalg.norm(_foot_site_vel(env, asset_cfg), dim=-1)
+    over = torch.clamp(speed - limit, min=0.0)
+    return -(over ** 2)
+
+
+def _interp_keyframes(t: torch.Tensor, keyframes) -> torch.Tensor:
+    """Piecewise-linear interpolation of ``keyframes`` = [(t0, v0), (t1, v1), ...] (t ascending)
+    at times ``t``; clamps to the end values outside the keyframe range."""
+    ts = torch.tensor([float(k[0]) for k in keyframes], device=t.device, dtype=t.dtype)
+    vs = torch.tensor([float(k[1]) for k in keyframes], device=t.device, dtype=t.dtype)
+    out = torch.full_like(t, float(vs[-1]))
+    out = torch.where(t <= ts[0], torch.full_like(t, float(vs[0])), out)
+    for i in range(len(keyframes) - 1):
+        t0, t1, v0, v1 = ts[i], ts[i + 1], vs[i], vs[i + 1]
+        seg = (t >= t0) & (t < t1)
+        a = (t - t0) / torch.clamp(t1 - t0, min=1e-6)
+        out = torch.where(seg, v0 + a * (v1 - v0), out)
+    return out
+
+
+def head_yaw_schedule_track(
+    env: ManagerBasedRlEnv,
+    keyframes,
+    std: float = 0.25,
+    joint_index: int = 7,
+    asset_cfg: SceneEntityCfg = _DEFAULT_ASSET_CFG,
+) -> torch.Tensor:
+    """Gaussian exp(-((q_yaw - target(t)) / std)^2) on the head_yaw servo (index 7) against a
+    SLEWED keyframe target: the target moves at a fixed rate, so being ahead of it pays
+    nothing (no jackpot for arriving early). +yaw = the robot's left (measured 2026-09-04)."""
+    asset: Entity = env.scene[asset_cfg.name]
+    q = torch.nan_to_num(_servo_joint_pos(env, asset)[:, joint_index], nan=0.0)
+    target = _interp_keyframes(_episode_time_s(env), keyframes)
+    return torch.exp(-((q - target) / std) ** 2)
+
+
+def pose_match_in_windows(
+    env: ManagerBasedRlEnv,
+    windows,
+    std: float = 0.25,
+    joint_indices: Optional[list] = None,
+    target_overrides: Optional[dict] = None,
+    asset_cfg: SceneEntityCfg = _DEFAULT_ASSET_CFG,
+) -> torch.Tensor:
+    """``pose_target_match`` (Gaussian on the servo joints vs HOME + overrides) paid only inside
+    ``windows`` — the 'ends standing near the stand pose' term."""
+    reward = pose_target_match(env, target_overrides=target_overrides, asset_cfg=asset_cfg,
+                               std=std, joint_indices=joint_indices)
+    return reward * _in_windows(env, windows)
+
+
+def stomp_success(
+    env: ManagerBasedRlEnv,
+    foot_cfg: SceneEntityCfg,
+    stomp_windows,
+    yaw_windows,
+    min_clearance: float = 0.02,
+    min_yaw: float = 0.5,
+    upright_gz: float = -0.9,
+    joint_index: int = 7,
+    asset_cfg: SceneEntityCfg = _DEFAULT_ASSET_CFG,
+) -> torch.Tensor:
+    """Diagnostic (weight 1e-3 so mjlab logs it): 1.0 on the LAST step of an episode in which
+    (1) the stomping foot cleared ``min_clearance`` at some step of EACH window in
+    ``stomp_windows``, (2) head yaw reached >= +min_yaw in yaw_windows[0] and <= -min_yaw in
+    yaw_windows[1], (3) the trunk is upright at the end (projected gravity z < upright_gz).
+    Latches live on the env (``_stomp_latch``, shape (N, 4)) and reset with the episode."""
+    n = env.num_envs
+    latch = getattr(env, "_stomp_latch", None)
+    if latch is None or latch.shape[0] != n:
+        latch = torch.zeros(n, 4, device=env.device, dtype=torch.bool)
+    fresh = env.episode_length_buf <= 1
+    latch[fresh] = False
+    z = _foot_site_z(env, foot_cfg)
+    asset: Entity = env.scene[asset_cfg.name]
+    q = torch.nan_to_num(_servo_joint_pos(env, asset)[:, joint_index], nan=0.0)
+    for i, w in enumerate(stomp_windows[:2]):
+        latch[:, i] |= (_in_windows(env, [w]) > 0.5) & (z >= min_clearance)
+    latch[:, 2] |= (_in_windows(env, [yaw_windows[0]]) > 0.5) & (q >= min_yaw)
+    latch[:, 3] |= (_in_windows(env, [yaw_windows[1]]) > 0.5) & (q <= -min_yaw)
+    env._stomp_latch = latch
+    gz = torch.nan_to_num(asset.data.projected_gravity_b[:, 2], nan=0.0)
+    final = env.episode_length_buf >= env.max_episode_length
+    ok = latch.all(dim=1) & (gz < upright_gz) & final
+    return ok.float()
