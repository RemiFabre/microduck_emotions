+    t = torch.tensor([0.0, 0.4, 0.5, 0.6, 0.9, 1.2, 1.4, 1.6, 1.8, 2.0, 2.1, 2.2, 3.0])
+    y = m._interp_keyframes(t, st.HEAD_YAW_KEYFRAMES)
+    A = st.HEAD_YAW_AMP
+    exp = [0.0, 0.0, A / 2, A, A, A, 0.0, -A, -A, -A, -A / 2, 0.0, 0.0]
