+# Timeline (seconds from the episode start). The policy never sees these. Generated from
+# N_STOMPS: settle, then one (lift, impact) pair per stomp every STOMP_PERIOD, then end stand.
+SETTLE_END   = 0.3
+STOMP_PERIOD = 0.5      # stomp-to-stomp spacing ("0.4 to 0.5 s apart")
+LIFT_DUR     = 0.25     # foot goes up
+IMPACT_DUR   = 0.20     # foot comes down and hits (0.05 s idle before the next lift)
+YAW_RAMP     = 0.2      # s for 0 -> ±A (3 rad/s); a full ±A -> ∓A swing takes 2 * YAW_RAMP
+HEAD_YAW_AMP = 0.6      # rad; +yaw = the robot's LEFT (measured 2026-09-04); stomp 1 = left
+# Fastest ramp 3 rad/s — inside an XL330's ~5 rad/s no-load speed.
+
+
+def _stomp_timeline(n: int = N_STOMPS):
+    """(lift_windows, impact_windows, stomp_windows, yaw_keyframes, yaw_success_windows, end_stand)."""
+    lifts, impacts, stomps, yaw_succ = [], [], [], []
+    kf = [(0.0, 0.0)]
+    prev_v = 0.0
+    for k in range(n):
+        t0 = SETTLE_END + k * STOMP_PERIOD
+        t_imp = t0 + LIFT_DUR
+        lifts.append((t0, t_imp))
+        impacts.append((t_imp, t_imp + IMPACT_DUR))
+        stomps.append((t0, t_imp + IMPACT_DUR))
+        sign = 1.0 if k % 2 == 0 else -1.0          # left, right, left, ...
+        v = sign * HEAD_YAW_AMP
+        ramp = YAW_RAMP * abs(v - prev_v) / HEAD_YAW_AMP
+        kf += [(t_imp - ramp, prev_v), (t_imp, v)]  # head arrives with the impact
+        yaw_succ.append((t_imp - 0.1, t_imp + 0.2, sign))
+        prev_v = v
+    t_end = stomps[-1][1]
+    kf += [(t_end + 0.2, prev_v), (t_end + 0.2 + YAW_RAMP, 0.0), (EPISODE_LENGTH_S, 0.0)]
+    end_stand = (round(t_end + 0.2 + YAW_RAMP + 0.05, 2), EPISODE_LENGTH_S)
+    r = lambda w: tuple(round(x, 3) for x in w)
+    return ([r(w) for w in lifts], [r(w) for w in impacts], [r(w) for w in stomps],
+            [(round(t, 3), v) for t, v in kf], [r(w) for w in yaw_succ], r(end_stand))
+
+
+LIFT_WINDOWS, IMPACT_WINDOWS, STOMP_WINDOWS, HEAD_YAW_KEYFRAMES, YAW_SUCCESS_WINDOWS, END_STAND = _stomp_timeline()
+assert END_STAND[0] < EPISODE_LENGTH_S - 0.5, "episode too short for N_STOMPS"
+
+FOOT_LIFT_TARGET  = 0.03    # m; "small lifts" — the ramp saturates here (no bonus for kicking higher)
 FOOT_LIFT_DEADZONE = 0.005  # m; the sole site reads -0.3 mm at the stand
-STOMP_V_CAP       = 0.4     # m/s; downward foot speed rewarded up to here (4 cm in 0.1 s)
+STOMP_V_CAP       = 0.3     # m/s; downward foot speed rewarded up to here (3 cm in 0.1 s)
