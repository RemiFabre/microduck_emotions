+"""Microduck *angry stomp* — a one-shot double stomp with a head turn (emotion display).
+
+Design: docs/superpowers/specs/2026-09-04-angry-stomp-design.md. From a normal stand the
+RIGHT foot lifts and bangs down twice; the head yaws LEFT (+) with the first stomp and
+RIGHT (-) with the second; the robot ends standing. Deployment = hot-swap this ONNX in
+from the stand policy with the 13-D command all zeros for 3.0 s (happy-hop contract).
+
+Template = microduck_ball_kick_env_cfg.py (Rémi, 2026-09-04: "Using flamingo for the stomp
+is a bad idea. I need a training from scratch for a much shorter movement — we're closer
+to the kick policy here"). Same standing spawn, support-foot anchor, loose leg pose,
+upright/height terms, DR block and action-rate ramp as the kick; trained from scratch.
+No single-support hold, no posture blend, no flamingo rewards or curricula.
+
+Key decisions:
+  - No clock in the observation. The env gates every task reward on fixed time windows
+    (elapsed episode time); the policy must keep time in its own body state (the head yaw
+    doubles as its memory register: left = stomp 1 done, right = stomp 2 done).
+  - Impact is REWARDED (downward foot velocity in the impact windows) but CAPPED at
+    STOMP_V_CAP, foot speed above FOOT_OVERSPEED is taxed, trunk |a_z| is taxed: a stomp,
+    not a slam (Rémi's veto: physically plausible for XL330 servos, no thrashing).
+  - One fixed foot (STOMP_FOOT): an emotion display needs no laterality; a mirror twin is
+    one flag away, like the kicks.
+  - Robot = robot_groundcontact.xml (the model every shipped policy was trained on; the
+    kick env's model) with BAM actuators and the WIDE actuator-delay DR (0-9 physics
+    steps = 0-45 ms): a one-shot gesture must not depend on the exact latency (the happy
+    hop trained at 3-6 only works WITH that delay; flamingo A5 collapsed off its lags).
+
+DR / noise / regularisers: mirrored from the ball-kick env (itself matched to
+standup/velocity — the recipe with proven transfer). The ONE deliberate deviation from the
+kick's robot cfg is ACTUATOR_DELAY_LAGS (0-9 instead of 3-6); set it to (3, 6) for the
+exact kick robot.
+"""
+
+import math
+from copy import deepcopy
+
+# ── Stomping foot: "right" or "left" ─────────────────────────────────────────
+STOMP_FOOT = "right"
+assert STOMP_FOOT in ("right", "left")
+
+# Symmetry — must stay OFF: one-sided task.
+ENABLE_SYMMETRY = False
+
+# ── Domain randomisation (matched to velocity / standup / kick) ──────────────
+ENABLE_COM_RANDOMIZATION             = True
+ENABLE_HEAD_COM_RANDOMIZATION        = True
+ENABLE_MASS_INERTIA_RANDOMIZATION    = True
+ENABLE_JOINT_FRICTION_RANDOMIZATION  = True
+ENABLE_ARMATURE_RANDOMIZATION        = True
+ENABLE_VELOCITY_PUSHES               = True
+ENABLE_IMU_ORIENTATION_RANDOMIZATION = True
+ENABLE_ENCODER_BIAS                  = True
+
+COM_RANDOMIZATION_RANGE             = 0.003           # ramped to 0.015 via curriculum
+HEAD_COM_RANDOMIZATION_RANGE        = 0.003           # ramped to 0.01 via curriculum
+MASS_INERTIA_RANDOMIZATION_RANGE    = (0.95, 1.05)
+ARMATURE_RANDOMIZATION_RANGE        = (0.9, 1.1)
+JOINT_FRICTION_RANDOMIZATION_RANGE  = (0.9, 1.1)
+ENCODER_BIAS_RANGE                  = (-0.015, 0.015)
+VELOCITY_PUSH_INTERVAL_S            = (3.0, 6.0)      # <= 1 push per 3.5 s episode
+VELOCITY_PUSH_RANGE                 = (-0.15, 0.15)   # final; ramped from 0
+IMU_ORIENTATION_RANDOMIZATION_ANGLE = 6.0
+ACTUATOR_DELAY_LAGS                 = (0, 9)          # physics steps (5 ms each): 0-45 ms
+
+# ── Task constants ────────────────────────────────────────────────────────────
+EPISODE_LENGTH_S  = 3.0
+NUM_STEPS_PER_ENV = 24
+
+# Timeline (seconds from the episode start). The policy never sees these.
+SETTLE_END  = 0.3
+LIFT_1      = (0.3, 0.6)
+IMPACT_1    = (0.6, 0.8)
+LIFT_2      = (1.1, 1.4)
+IMPACT_2    = (1.4, 1.6)
+END_STAND   = (2.2, EPISODE_LENGTH_S)
+LIFT_WINDOWS   = [LIFT_1, LIFT_2]
+IMPACT_WINDOWS = [IMPACT_1, IMPACT_2]
+STOMP_WINDOWS  = [(LIFT_1[0], IMPACT_1[1]), (LIFT_2[0], IMPACT_2[1])]   # lift ∪ impact per stomp
+# Head yaw target keyframes (t, rad); +yaw = the robot's LEFT (measured 2026-09-04).
+# Fastest ramp 3 rad/s (0.6 rad in 0.2 s) — inside an XL330's ~5 rad/s no-load speed.
+HEAD_YAW_AMP = 0.6
+HEAD_YAW_KEYFRAMES = [
+    (0.0, 0.0), (0.4, 0.0), (0.6, HEAD_YAW_AMP), (1.2, HEAD_YAW_AMP),
+    (1.6, -HEAD_YAW_AMP), (2.0, -HEAD_YAW_AMP), (2.2, 0.0), (EPISODE_LENGTH_S, 0.0),
+]
+YAW_LEFT_WINDOW  = (0.6, 1.2)    # success metric: yaw >= +0.5 somewhere in here
+YAW_RIGHT_WINDOW = (1.6, 2.0)    # and <= -0.5 somewhere in here
+
+FOOT_LIFT_TARGET  = 0.04    # m; the ramp saturates here (no bonus for kicking higher)
+FOOT_LIFT_DEADZONE = 0.005  # m; the sole site reads -0.3 mm at the stand
+STOMP_V_CAP       = 0.4     # m/s; downward foot speed rewarded up to here (4 cm in 0.1 s)
+FOOT_OVERSPEED    = 0.8     # m/s; foot speed taxed quadratically above this
+SUCCESS_CLEARANCE = 0.02    # m
+SUCCESS_YAW       = 0.5     # rad
+
+# Trunk standing height: 116.6 mm measured 2026-09-04 (STAND keyframe, stiff servo, groundcontact model).
+STAND_Z = 0.116
+
+_LEG_JOINTS   = [0, 1, 2, 3, 4, 9, 10, 11, 12, 13]
+_HEAD_LEVEL   = [5, 6, 8]          # neck_pitch, head_pitch, head_roll (NOT head_yaw)
+HEAD_YAW_IDX  = 7
+_ALL_JOINTS   = list(range(14))
+
+from mjlab.entity import EntityArticulationInfoCfg, EntityCfg
+from mjlab.envs import ManagerBasedRlEnvCfg
+from mjlab.envs.mdp import dr
+from mjlab.envs.mdp.actions import JointPositionActionCfg
+from mjlab.managers import (
+    CurriculumTermCfg,
+    EventTermCfg,
+    ObservationTermCfg,
+    RewardTermCfg,
+    TerminationTermCfg,
+)
+from mjlab.managers.scene_entity_config import SceneEntityCfg
+from mjlab.rl import RslRlModelCfg, RslRlOnPolicyRunnerCfg
+from mjlab.sensor import ContactMatch, ContactSensorCfg
+from mjlab.tasks.velocity import mdp
+from mjlab.tasks.velocity.velocity_env_cfg import make_velocity_env_cfg
+from mjlab.utils.noise import UniformNoiseCfg as Unoise
+
+from mjlab_microduck.actuator import FrictionDRBamActuatorCfg
+from mjlab_microduck.robot.microduck_constants import (
+    _BAM_ACTUATOR_KWARGS,
+    FULL_COLLISION,
+    HOME_FRAME,
+    get_standup_spec,
+)
+from mjlab_microduck.tasks import mdp as microduck_mdp
+from mjlab_microduck.tasks.microduck_velocity_env_cfg import (
+    HEAD_BODY_NAMES,
+    HEAD_POSE_CMD_RESAMPLE_S,
+)
+from mjlab_microduck.tasks.symmetry import PpoWithSymmetryCfg, SYMMETRY_CFG
+
+# Same BAM XL330 model as every shipped policy, wider actuator-delay DR (see docstring).
+stomp_actuators = FrictionDRBamActuatorCfg(
+    **{**_BAM_ACTUATOR_KWARGS,
+       "delay_min_lag": ACTUATOR_DELAY_LAGS[0], "delay_max_lag": ACTUATOR_DELAY_LAGS[1]}
+)
+STOMP_ROBOT_CFG = EntityCfg(
+    spec_fn=get_standup_spec,          # robot_groundcontact.xml
+    init_state=HOME_FRAME,
+    collisions=(FULL_COLLISION,),
+    articulation=EntityArticulationInfoCfg(
+        actuators=(stomp_actuators,),
+        soft_joint_pos_limit_factor=0.9,
+    ),
+)
+
+
+def make_microduck_stomp_env_cfg(
+    play: bool = False,
+    stomp_foot: str | None = None,
+) -> ManagerBasedRlEnvCfg:
+    """Angry double-stomp env. ``stomp_foot`` overrides STOMP_FOOT (tests)."""
+    stomp_foot = stomp_foot or STOMP_FOOT
+    assert stomp_foot in ("right", "left")
+    support_foot = "left" if stomp_foot == "right" else "right"
+    # feet_ground_contact slots follow the pattern order: 0 = left, 1 = right.
+    stomp_slot   = 1 if stomp_foot == "right" else 0
+    support_slot = 1 - stomp_slot
+    stomp_site   = SceneEntityCfg("robot", site_names=[f"{stomp_foot}_foot"])
+
+    feet_ground_cfg = ContactSensorCfg(
+        name="feet_ground_contact",
+        primary=ContactMatch(
+            mode="geom",
+            pattern=r"^(left_foot_collision|right_foot_collision)$",   # LEFT first, RIGHT second
+            entity="robot",
+        ),
+        secondary=ContactMatch(mode="body", pattern="terrain"),
+        fields=("found", "force"),
+        reduce="netforce",
+        num_slots=1,
+        track_air_time=True,
+    )
+    self_collision_cfg = ContactSensorCfg(
+        name="self_collision",
+        primary=ContactMatch(mode="subtree", pattern="trunk_base", entity="robot"),
+        secondary=ContactMatch(mode="subtree", pattern="trunk_base", entity="robot"),
+        fields=("found",),
+        reduce="none",
+        num_slots=1,
+    )
+    foot_frictions_geom_names = ("left_foot_collision", "right_foot_collision")
+
+    # ── Base config ───────────────────────────────────────────────────────────
+    cfg = make_velocity_env_cfg()
+    cfg.scene.entities = {"robot": STOMP_ROBOT_CFG}
+    cfg.scene.sensors = (feet_ground_cfg, self_collision_cfg)
+    cfg.viewer.body_name = "trunk_base"
+    cfg.episode_length_s = EPISODE_LENGTH_S
+
+    joint_pos_action = cfg.actions["joint_pos"]
+    assert isinstance(joint_pos_action, JointPositionActionCfg)
+    joint_pos_action.scale = 1.0
+
+    # ── Rewards: drop the walking-specific terms ──────────────────────────────
+    for name in [
+        "track_linear_velocity", "track_angular_velocity",
+        "air_time", "foot_clearance", "foot_swing_height", "foot_slip",
+        "pose",           # gait-conditioned; replaced by pose_stand_legs below
+        "head_pose_tracking", "body_pose_tracking", "head_pose_bias",
+        "soft_landing", "hip_yaw_roll_deviation",
+    ]:
+        cfg.rewards.pop(name, None)
