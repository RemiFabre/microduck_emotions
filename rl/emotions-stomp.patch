+"""Angry stomp env (Mjlab-Stomp-Flat-MicroDuck): cfg invariants.
+
+Locks in: the robot model + BAM actuator with the wide delay DR, joint/foot indices resolving
+on the actual model, the sign of every reward weight, the 61-D obs slot layout, and the
+time-window gates + head-yaw schedule opening when the timeline says so.
+"""
+import math
+
+import mujoco
+import torch
+
+from mjlab_microduck.robot.microduck_constants import MICRODUCK_GROUNDCONTACT_XML
+from mjlab_microduck.tasks import mdp as m
+from mjlab_microduck.tasks import microduck_stomp_env_cfg as st
+from mjlab_microduck.tasks.microduck_stomp_env_cfg import (
+    MicroduckStompRlCfg,
+    STOMP_ROBOT_CFG,
+    make_microduck_stomp_env_cfg,
+)
+
+SERVO_ORDER = [
+    "left_hip_yaw", "left_hip_roll", "left_hip_pitch", "left_knee", "left_ankle",
+    "neck_pitch", "head_pitch", "head_yaw", "head_roll",
+    "right_hip_yaw", "right_hip_roll", "right_hip_pitch", "right_knee", "right_ankle",
+]
+
+
+# ── Robot model / actuator ─────────────────────────────────────────────────────
+
+def test_robot_is_the_groundcontact_model_with_bam_and_wide_delay_dr():
+    cfg = make_microduck_stomp_env_cfg()
+    assert cfg.scene.entities["robot"] is STOMP_ROBOT_CFG
+    spec = STOMP_ROBOT_CFG.spec_fn()
+    assert spec.modelname or True  # compiles below
+    model = spec.compile()
+    # the groundcontact XML is what get_standup_spec loads
+    assert MICRODUCK_GROUNDCONTACT_XML.name == "robot_groundcontact.xml"
+    act = STOMP_ROBOT_CFG.articulation.actuators[0]
+    assert type(act).__name__ == "FrictionDRBamActuatorCfg"
+    assert act.motor_name == "xl330" and act.kp_fw == 200.0
+    assert (act.delay_min_lag, act.delay_max_lag) == (0, 9)
+    assert "expand_bam_friction_fields" in cfg.events   # BAM invariant (AGENTS.md)
+    assert cfg.events["expand_bam_friction_fields"].mode == "startup"
+    assert "randomize_joint_friction" in cfg.events      # BAM friction DR, not dof_frictionloss
+    assert model.nu == 14
+
+
+def test_joint_and_foot_indices_resolve_on_the_actual_model():
+    model = STOMP_ROBOT_CFG.spec_fn().compile()
+    names = [mujoco.mj_id2name(model, mujoco.mjtObj.mjOBJ_JOINT, j) for j in range(model.njnt)]
+    servo = [n for n in names if n and not n.startswith("passive_") and n != "floating_base"]
+    servo = [n for n in servo if model.jnt_type[names.index(n)] == mujoco.mjtJoint.mjJNT_HINGE]
+    assert servo == SERVO_ORDER, servo
+    assert servo[st.HEAD_YAW_IDX] == "head_yaw"
+    assert [servo[i] for i in st._HEAD_LEVEL] == ["neck_pitch", "head_pitch", "head_roll"]
+    assert all(("hip" in servo[i]) or ("knee" in servo[i]) or ("ankle" in servo[i]) for i in st._LEG_JOINTS)
+    sites = [mujoco.mj_id2name(model, mujoco.mjtObj.mjOBJ_SITE, s) for s in range(model.nsite)]
+    assert "right_foot" in sites and "left_foot" in sites
+    geoms = [mujoco.mj_id2name(model, mujoco.mjtObj.mjOBJ_GEOM, g) for g in range(model.ngeom)]
+    assert "left_foot_collision" in geoms and "right_foot_collision" in geoms
+    # head_yaw range comfortably holds the ±0.6 rad schedule + the success threshold
+    jy = mujoco.mj_name2id(model, mujoco.mjtObj.mjOBJ_JOINT, "head_yaw")
+    lo, hi = model.jnt_range[jy]
+    assert lo < -st.HEAD_YAW_AMP - 0.2 and hi > st.HEAD_YAW_AMP + 0.2
+    assert st.SUCCESS_YAW < st.HEAD_YAW_AMP
+
+
+def test_right_foot_stomps_left_foot_supports():
+    cfg = make_microduck_stomp_env_cfg()
+    assert cfg.rewards["stomp_foot_lift"].params["asset_cfg"].site_names == ["right_foot"]
+    assert cfg.rewards["stomp_foot_impact"].params["asset_cfg"].site_names == ["right_foot"]
+    assert cfg.rewards["foot_overspeed"].params["asset_cfg"].site_names == ["right_foot"]
+    assert cfg.rewards["support_foot_grounded"].params["slot"] == 0      # left
+    assert cfg.rewards["stomp_foot_planted"].params["slot"] == 1         # right
+    assert cfg.rewards["stomp_foot_lift"].params["gate_slot"] == 0       # gated on the LEFT foot
+    assert cfg.rewards["stomp_foot_impact"].params["gate_slot"] == 0
+    feet = [s for s in cfg.scene.sensors if s.name == "feet_ground_contact"][0]
+    assert feet.primary.pattern.startswith("^(left_foot_collision|right_foot_collision)")
+    # the left-footed twin flips everything
+    cfg_l = make_microduck_stomp_env_cfg(stomp_foot="left")
+    assert cfg_l.rewards["stomp_foot_lift"].params["asset_cfg"].site_names == ["left_foot"]
+    assert cfg_l.rewards["support_foot_grounded"].params["slot"] == 1
+    assert cfg_l.rewards["stomp_foot_planted"].params["slot"] == 0
+
+
+# ── Reward signs ───────────────────────────────────────────────────────────────
+
+def test_reward_weights_have_the_intended_sign():
+    cfg = make_microduck_stomp_env_cfg()
+    positive_task = ["stomp_foot_lift", "stomp_foot_impact", "stomp_foot_planted",
+                     "support_foot_grounded", "head_yaw_track", "pose_stand_legs",
+                     "pose_head_level", "end_stand", "upright", "height_stand", "stomp_success"]
+    self_negating = ["trunk_az", "foot_overspeed"]          # return <= 0 -> POSITIVE weight
+    costs = ["dof_pos_limits", "action_rate_l2", "body_ang_vel",
+             "angular_momentum", "self_collisions"]         # return >= 0 -> NEGATIVE weight
+    for n in positive_task + self_negating:
+        assert cfg.rewards[n].weight > 0, n
+    for n in costs:
+        assert cfg.rewards[n].weight < 0, n
+    assert "joint_torque_rate_l2" not in cfg.rewards and "joint_limit_proximity" not in cfg.rewards
+    assert cfg.rewards["stomp_success"].weight == 1e-3          # diagnostic, logged
+    assert cfg.rewards["trunk_az"].func is m.trunk_vertical_accel_penalty
+    assert cfg.rewards["foot_overspeed"].func is m.foot_overspeed_penalty
+    for n in ("track_linear_velocity", "track_angular_velocity", "air_time", "foot_slip",
+              "pose", "head_pose_tracking", "body_pose_tracking", "soft_landing"):
+        assert n not in cfg.rewards, n
+
+
+def test_stomp_is_capped_not_a_slam():
+    cfg = make_microduck_stomp_env_cfg()
+    assert cfg.rewards["stomp_foot_impact"].params["v_cap"] == st.STOMP_V_CAP == 0.4
+    assert cfg.rewards["foot_overspeed"].params["limit"] == st.FOOT_OVERSPEED == 0.8
+    assert st.FOOT_OVERSPEED >= 2 * st.STOMP_V_CAP
+    assert cfg.rewards["stomp_foot_lift"].params["target"] == 0.04
+    assert cfg.rewards["stomp_foot_lift"].params["dead_zone"] == 0.005
+    assert cfg.rewards["trunk_az"].weight == 0.005
+    # smoothness is introduced after discovery and stops short of the walking value
+    stages = cfg.curriculum["action_rate_weight"].params["weight_stages"]
+    assert stages[0] == {"step": 0, "weight": -0.1}
+    assert stages[-1]["weight"] == -0.6 and stages[-1]["step"] == 1000 * 24
+    assert "torque_rate_weight" not in cfg.curriculum
+
+
+# ── Observations / commands / terminations ─────────────────────────────────────
+
+def test_actor_observation_keeps_the_61d_slot_layout():
+    cfg = make_microduck_stomp_env_cfg()
+    terms = cfg.observations["actor"].terms
+    assert "base_lin_vel" not in terms and "height_scan" not in terms and "foot_height" not in terms
+    keys = list(terms.keys())
+    # command block last and in runtime order [twist(3), head(4), body(6)]
+    assert keys[-3:] == ["command", "head_command", "body_command"] or keys[-2:] == ["head_command", "body_command"]
+    assert terms["head_command"].params["command_name"] == "head_pose"
+    assert terms["body_command"].params["command_name"] == "body_pose"
+    assert len(cfg.commands["head_pose"].ranges) == 4
+    assert len(cfg.commands["body_pose"].ranges) == 6
+    # every slot alive with a tiny non-zero range (no dead weights), nothing large
+    for lo, hi in cfg.commands["head_pose"].ranges + cfg.commands["body_pose"].ranges:
+        assert lo < 0 < hi and hi <= 0.07
+    tw = cfg.commands["twist"].ranges
+    assert tw.lin_vel_x == (-0.01, 0.01) and tw.ang_vel_z == (-0.05, 0.05)
+    assert terms["joint_pos"].params["biased"] is True
+    assert cfg.observations["critic"].terms["joint_pos"].params["biased"] is False
+
+
+def test_obs_parity_with_the_kick_env():
+    """Same actor layout as the kick (the template); the critic differs only by the kick's
+    private ball terms."""
+    from mjlab_microduck.tasks.microduck_ball_kick_env_cfg import make_microduck_ball_kick_env_cfg
+    a = make_microduck_stomp_env_cfg()
+    b = make_microduck_ball_kick_env_cfg()
+    assert list(a.observations["actor"].terms.keys()) == list(b.observations["actor"].terms.keys())
+    crit_b = [k for k in b.observations["critic"].terms if not k.startswith("ball_")]
+    assert list(a.observations["critic"].terms.keys()) == crit_b
+
+
+def test_recipe_is_the_kick_not_flamingo():
+    """Rémi 2026-09-04: from scratch on the kick recipe, short episode, no flamingo terms."""
+    cfg = make_microduck_stomp_env_cfg()
+    assert 2.0 <= cfg.episode_length_s <= 3.0
+    for n in ("com_over_stance_foot", "swing_foot_clear", "swing_foot_touch", "gravity_flamingo",
+              "stillness", "stance_side_tilt", "nonfoot_touch_tax", "head_upside_down"):
+        assert n not in cfg.rewards, n
+    assert "set_flamingo_state" not in cfg.events and "set_ground_state" in cfg.events
+    assert "nonfoot_ground" not in cfg.terminations
+    assert cfg.actions["joint_pos"].clip is None
+    assert cfg.rewards["dof_pos_limits"].weight == -1.0
+
+
+def test_terminations_spawn_and_episode():
+    cfg = make_microduck_stomp_env_cfg()
+    assert "fell_over" in cfg.terminations and "nan_state" in cfg.terminations
+    assert "time_out" in cfg.terminations
+    assert cfg.episode_length_s == 3.0
+    sp = cfg.events["set_ground_state"].params
+    assert sp["standing_prob"] == 1.0 and sp["face_down_prob"] == sp["face_up_prob"] == sp["sitting_prob"] == 0.0
+    assert sp["standing_z_min"] <= st.STAND_Z <= sp["standing_z_max"]
+    assert cfg.events["reset_robot_joints"].params["position_range"] == (-0.05, 0.05)
+    push = cfg.curriculum["push_magnitude"].params["push_stages"]
+    assert push[0]["velocity_range"]["x"] == (0.0, 0.0)
+    assert push[-1]["velocity_range"]["x"][1] <= 0.15
+    assert cfg.scene.terrain.terrain_type == "plane"
+
+
+def test_runner_cfg():
